# Optional MongoDB connection string for production persistence (can also be connected from hidden Admin Panel)
MONGODB_URI=
MONGODB_DB_NAME=akvai_associates

# Secret dynamic URL path for the hidden owner Admin Panel: /portal/<ADMIN_SECRET_SLUG>
# Example: ADMIN_SECRET_SLUG=akvai-owner-7x9k2m
ADMIN_SECRET_SLUG=

# Optional server-side Admin credentials override (if unset, claim once at /portal/owner-setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional session signing secret (auto-generated in memory if omitted)
SESSION_SECRET=
